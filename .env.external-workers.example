# Copy to .env.external-workers locally. NEVER commit the real file.
DJANGO_SETTINGS_MODULE=deriv_platform.settings
DJANGO_ENV=production

# Use the EXTERNAL connection URLs from Render.
DATABASE_URL=
REDIS_URL=

# Use the same application secret as the Render web service.
SECRET_KEY=

USE_REDIS=true
USE_CELERY=true
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=
