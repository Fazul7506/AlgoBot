# Django core
SECRET_KEY=
DEBUG=false
ALLOWED_HOSTS=127.0.0.1,localhost,testserver,algobot.dpdns.org,api.algobot.dpdns.org
BASE_URL=http://127.0.0.1:8000
TIME_ZONE=Africa/Nairobi
ALGO_API_BASE_URL=https://api.algobot.dpdns.org
CORS_ALLOWED_ORIGINS=https://algobot.dpdns.org
CSRF_TRUSTED_ORIGINS=https://algobot.dpdns.org
SESSION_COOKIE_DOMAIN=.algobot.dpdns.org
CSRF_COOKIE_DOMAIN=.algobot.dpdns.org
DATABASE_URL=
USE_POSTGRES=false
POSTGRES_DB=deriv_platform
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
REDIS_URL=redis://localhost:6379/0
USE_REDIS=false
USE_CELERY=true
DERIV_OAUTH_CLIENT_ID=
DERIV_OAUTH_CLIENT_SECRET=
DERIV_OAUTH_SCOPE=trade
DERIV_APP_ID=
DERIV_API_BASE_URL=https://api.derivws.com
DERIV_OPTIONS_ACCOUNTS_URL=https://api.derivws.com/trading/v1/options/accounts
DERIV_PUBLIC_WS_URL=wss://api.derivws.com/trading/v1/options/ws/public
DERIV_AUTH_WS_BASE_URL=wss://api.derivws.com/trading/v1/options/ws
DERIV_REDIRECT_URI=http://127.0.0.1:8000/callback/
ALLOW_LIVE_TRADING=false
ENABLE_BROKER_ACCOUNT_SWITCH=true
# Email / notification delivery
DEFAULT_FROM_EMAIL=noreply@algobot.dpdns.org
EMAIL_BACKEND=anymail.backends.brevo.EmailBackend
# Brevo transactional API key; never use SMTP credentials.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=noreply@algobot.dpdns.org
ALGOBOT_SECURITY_EMAIL=security@algobot.dpdns.org
ALGOBOT_SUPPORT_EMAIL=support@algobot.dpdns.org
ALGOBOT_NOREPLY_EMAIL=noreply@algobot.dpdns.org
# Google Cloud OAuth 2.0 Web Client. Register this exact callback in Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://algobot.dpdns.org/api/notifications/channels/gmail/callback/
# Account login callback; register this URI in the existing Google OAuth client.
GOOGLE_LOGIN_REDIRECT_URI=https://algobot.dpdns.org/auth/google/callback/
# AlgoBot Telegram bot credentials
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_MODE=webhook
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_API_TIMEOUT=10
TELEGRAM_RETRY_MAX_ATTEMPTS=6
# Payments
PAYMENT_PROVIDER=intasend
PAYMENT_HTTP_TIMEOUT=20
ALGOBOT_BILLING_CURRENCY=KES
ALGOBOT_BASIC_PRICE_CENTS=99900
ALGOBOT_PRO_PRICE_CENTS=499900
ALGOBOT_ENTERPRISE_PRICE_CENTS=2499900
ALGOBOT_SUBSCRIPTION_PERIOD_DAYS=30
# Explicit production application callback URLs. Checkout URLs themselves are generated dynamically by each provider.
BILLING_SUCCESS_URL=https://algobot.dpdns.org/billing/success/
BILLING_CANCEL_URL=https://algobot.dpdns.org/billing/cancel/
PESAPAL_CALLBACK_URL=https://algobot.dpdns.org/payments/pesapal/callback/
PESAPAL_CANCELLATION_URL=https://algobot.dpdns.org/billing/cancel/
INTASEND_PUBLIC_KEY=
INTASEND_SECRET_KEY=
INTASEND_WEBHOOK_CHALLENGE=
INTASEND_API_BASE_URL=https://api.intasend.com
# Optional: populate only with tariffs enabled for your IntaSend merchant account.
INTASEND_MOBILE_TARIFF=
INTASEND_CARD_TARIFF=
PESAPAL_CONSUMER_KEY=
PESAPAL_CONSUMER_SECRET=
PESAPAL_NOTIFICATION_ID=
PESAPAL_API_BASE_URL=https://pay.pesapal.com/v3
SENTRY_DSN=
# Generate a Fernet key and store it only in deployment secrets.
CREDENTIALS_ENCRYPTION_KEY=
AUDIT_LOG_ENABLED=true
TWO_FACTOR_ENABLED=true
TWO_FACTOR_ISSUER=AlgoBot
SESSION_COOKIE_SECURE=false
CSRF_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=Lax
CSRF_COOKIE_SAMESITE=Lax


# AI provider credentials must be supplied by deployment secrets/environment.
# Leave unused provider keys blank. Never commit real keys to this file.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_PROJECT_MANAGER_MODEL=gpt-4.1
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.3-70b-instruct
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-oss-20b
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_MODEL=gemini-2.5-flash
CEREBRAS_API_KEY=
CEREBRAS_BASE_URL=https://api.cerebras.ai/v1
CEREBRAS_MODEL=llama-3.3-70b

# Cloudflare unified push infrastructure. Generate independent high-entropy tokens
# and store real values only in Render environment secrets and Cloudflare Worker secrets.
CLOUDFLARE_MARKET_STREAM_TOKEN=
CLOUDFLARE_TASK_DISPATCH_TOKEN=
CLOUDFLARE_TRAINING_WEBHOOK_TOKEN=
# Keep both activation flags false until the production cutover checklist is approved.
CLOUDFLARE_SCHEDULER_ACTIVE=false
CLOUDFLARE_MARKET_STREAM_ACTIVE=false
ENABLE_EXECUTION_QUEUE_RECOVERY=false

# Durable AI model artifacts: Cloudflare R2 (S3-compatible API).
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET=
AI_MODEL_SIGNING_KEY=
AI_MODEL_PREFIX=algobot/models
# Redis must be shared by Django web/ASGI and Celery processes for idempotency and Channels.
REDIS_CHANNEL_MAX_CONNECTIONS=2
